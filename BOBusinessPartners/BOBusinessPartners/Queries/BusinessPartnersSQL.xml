<?xml version="1.0" encoding="utf-8" ?>

<Queries>
  
  <GetBusinessPartnersCRM>
    EXEC [BO_spSincronizacionSocioNegociosCRM]
  </GetBusinessPartnersCRM>

  <GetDireccionesCRM>
    EXEC [BO_spSincronizacionDireccionesCRM]
  </GetDireccionesCRM>

  <GetCotizacionesCabeceraCRM>
    EXEC [BO_spSincronizacionCotizacionesCabeceraCRM]
  </GetCotizacionesCabeceraCRM>

  <GetCotizacionesLineasCRM>
    EXEC [BO_spSincronizacionCotizacionesLineasCRM] '%DocEntry%'
  </GetCotizacionesLineasCRM>

  <GetInsertBusinessPartnersCRM>
    UPDATE [dbo].[@BO_CRM_OCRD] SET U_CP_ES = 'I' WHERE U_CP_CardCode = '%CardCode%'
  </GetInsertBusinessPartnersCRM>

  <GetInsertBusinessPartnersCRMError>
    UPDATE [dbo].[@BO_CRM_OCRD] SET U_CP_ES = 'E', U_CP_Observaciones = '%Error%'  WHERE U_CP_CardCode = '%CardCode%'
  </GetInsertBusinessPartnersCRMError>

  <GetUpdateDireccionesCRM>
    UPDATE [dbo].[@BO_CRM_CRD1] SET U_CP_ES = 'I' WHERE U_CP_BPCode = '%CardCode%'
  </GetUpdateDireccionesCRM>

  <GetUpdateDireccionesCRMError>
    UPDATE [dbo].[@BO_CRM_CRD1] SET U_CP_ES = 'E', U_CP_Observaciones = '%Error%'  WHERE U_CP_BPCode = '%CardCode%'
  </GetUpdateDireccionesCRMError>

  <GetUpdateCotizacionesCRM>
    UPDATE [dbo].[@BO_CRM_OQUT] SET U_CP_ES = 'I' WHERE U_CP_HXC = '%DocEntry%'
  </GetUpdateCotizacionesCRM>

  <GetUpdateCotizacionesCRMError>
    UPDATE [dbo].[@BO_CRM_OQUT] SET U_CP_ES = 'I' WHERE U_CP_HXC = '%DocEntry%'
  </GetUpdateCotizacionesCRMError>

</Queries>
